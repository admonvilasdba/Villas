# --- Copia este archivo a .env para desarrollo local ---

# Clave secreta de Django (genera una propia en producción).
SECRET_KEY=change-me

# Depuración (True en local, False en producción).
DEBUG=True

# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF (dominio de Render + custom domain).
# Ejemplo: https://vilas-carta.onrender.com,https://midominio.com
CSRF_TRUSTED_ORIGINS=

# Base de datos. Vacío => SQLite en desarrollo.
# En Render: postgres://usuario:clave@host:5432/vilas
DATABASE_URL=

# Zona horaria.
TIME_ZONE=America/Mexico_City

# Almacenamiento de imágenes en Cloudinary (opcional en local).
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
