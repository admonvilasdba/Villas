# --- Copia este archivo a .env para desarrollo local ---

# Clave secreta de Django (genera una propia en producción).
SECRET_KEY=change-me

# Depuración (True en local, False en producción).
DEBUG=True

# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF (dominio de Render + custom domain).
# Ejemplo: https://vilas-carta.onrender.com,https://midominio.com
CSRF_TRUSTED_ORIGINS=

# Base de datos. Vacío => SQLite en desarrollo.
# En producción: cadena de conexión de Supabase (PostgreSQL permanente).
# Usa la del Session Pooler (soporta IPv4):
# postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Zona horaria.
TIME_ZONE=America/Mexico_City

# Clave de API de ImgBB (obsoleta tras migrar a Supabase Storage)
IMGBB_API_KEY=

# Supabase Storage (S3-compatible) - subidas desde /admin/
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET_NAME=imagenes
SUPABASE_S3_REGION_NAME=auto
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# Superusuario automático (solo lo usa el comando create_admin).
# En local normalmente usa `manage.py createsuperuser`; estas variables
# permiten crear el admin automáticamente en el build de Render.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
